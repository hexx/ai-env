{
  // プロファイル定義 (仕事用/プライベート用)
  // 各プロファイルに OCR 全体設定を記述
  "profiles": {
    "pi-private": {
      // このProfileでKeychainから取得し、コンテナへ渡してよいクレデンシャル。
      // OPENAI_API_KEY と ZAI_PLATFORM_API_KEY(Z.AI Platform API)を追加済み。
      // pi 組み込み provider zai が使う ZAI_API_KEY(Z.AI Coding Plan)は対象外
      // (課金経路が違うため混線させない)。
      "credentialKeys": [
        "BRAVE_SEARCH_API_KEY",
        "DEEPSEEK_API_KEY",
        "GH_TOKEN",
        "JINA_API_KEY",
        "LLM_API_KEY",
        "OPENAI_API_KEY",
        "OPENCODE_API_KEY",
        "OPENROUTER_API_KEY",
        "QWEN_TOKEN_PLAN_API_KEY",
        "XIAOMI_TOKEN_PLAN_SGP_API_KEY",
        "ZAI_PLATFORM_API_KEY"
      ],
      "OCR_USE_ANTHROPIC": "false",
      // OpenCode のエンドポイント
      "OCR_LLM_URL": "https://opencode.ai/zen/go/v1",
      "OCR_LLM_TOKEN_KEY": "OPENCODE_API_KEY",
      "OCR_LLM_MODEL": "mimo-v2.5-pro"
      // GPT-5.6 LunaをProfileのデフォルトにする場合は、上記Profileへ次を追加する。
      // "provider": "openai",
      // "model": "gpt-5.6-luna",
      // "apiKeyEnv": "OPENAI_API_KEY"
      //
      // Z.AI Platform API をProfileのデフォルトにする場合は次を追加する。
      // zai-platform は Pi の Provider Catalog(~/.pi/agent/models.json)が宣言する
      // カスタム provider で、ai-env はその生成も存在検証も行わない。
      // "provider": "zai-platform",
      // "model": "glm-5.3-flash",
      // "apiKeyEnv": "ZAI_PLATFORM_API_KEY"
    }
    // 仕事用Profileの例（非アクティブ）。
    // WORK_API_KEYは現在のCREDENTIAL_SOURCESに登録されていないため、
    // 実際に使う場合は取得元を別途実装してから、Profileへ追加する。
    // "pi-work": {
    //   "credentialKeys": [
    //     "BRAVE_SEARCH_API_KEY",
    //     "GH_TOKEN",
    //     "JINA_API_KEY",
    //     "WORK_API_KEY"
    //   ],
    //   "OCR_USE_ANTHROPIC": "true",
    //   "OCR_LLM_URL": "https://api.anthropic.com/v1/messages",
    //   "OCR_LLM_TOKEN_KEY": "WORK_API_KEY",
    //   "OCR_LLM_MODEL": "claude-3-5-sonnet-20241022",
    //   "provider": "anthropic",
    //   "model": "claude-3-5-sonnet-20241022",
    //   "apiKeyEnv": "WORK_API_KEY"
    // }
  },
  // プロジェクトごとの pi 起動設定
  // 各プロジェクトに provider / model / apiKeyEnv を任意で指定。
  // 未指定時はプロファイルのデフォルト値にフォールバックする。
  // session は廃止: コンテナ内 cwd がプロジェクトごとに分かれるため、
  // pi -c(前回セッションの続行)でセッション再開を実現する(docs/adr/0005 参照)。
  "projects": {
    "ai-env": {
      "provider": "opencode-go",
      "model": "minimax-m3",
      "apiKeyEnv": "LLM_API_KEY"
    },
    "mindmap": {
      "model": "deepseek-v4-flash:high"
    },
    "task-manager": {}
  }
}
