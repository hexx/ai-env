#!/usr/bin/env bash
# コンテナ起動時の共通初期化スクリプト
# SSH キーセットアップ → pm2 管理下の socat ブリッジ → pi-resume 関数を .bashrc に注入

set -euo pipefail

# SSH キーセットアップ
cp -r /tmp/.ssh ~/.ssh && \
chown -R $(id -u):$(id -g) ~/.ssh && \
chmod 700 ~/.ssh && \
find ~/.ssh -type f -exec chmod 600 {} \; && \
mkdir -p ~/.config/herdr && \
ln -sf /home/pi/.rtk /home/pi/.config/rtk && \
RTK_TELEMETRY_DISABLED=1 rtk init -g --agent pi && \
pm2 start socat --name "herdr-socat" -- UNIX-LISTEN:/home/pi/.config/herdr/herdr.sock,fork,reuseaddr TCP:${HOST_IP}:9123

# herdr 0.8.0 のセッション再アンカー競合への対処（ADR 0003）
# agent_start 時のセッション報告に認識済み reason ("resume") を付与し、
# 起動直後に報告が無視されても次のターンで自己修復できるようにする。
# herdr 管理ファイルのため統合バージョンが v8 のときのみパッチする
# （将来バージョンで構造が変わる可能性があるため。パッチ済みならスキップ）。
if [ -f ~/.pi/agent/extensions/herdr-agent-state.ts ] \
  && grep -q 'HERDR_INTEGRATION_VERSION=8' ~/.pi/agent/extensions/herdr-agent-state.ts \
  && ! grep -q 'void reportSession("resume")' ~/.pi/agent/extensions/herdr-agent-state.ts; then
  sed -i 's|void reportSession();|void reportSession("resume");|' ~/.pi/agent/extensions/herdr-agent-state.ts
fi

# pi-resume 関数を .bashrc に注入
cat << 'PI_RESUME_EOF' >> /home/pi/.bashrc
{{PI_RESUME_FUNC}}
PI_RESUME_EOF