#!/usr/bin/env bash
# コンテナ起動時の共通初期化スクリプト
# SSH キーセットアップ → pi-resume 関数を .bashrc に注入
# herdr.sock は container run --volume でホストから直接マウントされるため、
# コンテナ内での socat ブリッジは不要。

set -euo pipefail

# SSH キーセットアップ
cp -r /tmp/.ssh ~/.ssh && \
chown -R $(id -u):$(id -g) ~/.ssh && \
chmod 700 ~/.ssh && \
find ~/.ssh -type f -exec chmod 600 {} \; && \
mkdir -p ~/.config/herdr && \
ln -sf /home/pi/.rtk /home/pi/.config/rtk

# pi-resume 関数を .bashrc に注入
cat << 'PI_RESUME_EOF' >> /home/pi/.bashrc
{{PI_RESUME_FUNC}}
PI_RESUME_EOF